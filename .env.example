# Copie para .env. Nunca adicione suas chaves ao Git.
JARVIS_DATA_DIR=./data
# Obrigatório antes de expor o serviço fora de localhost. Use uma senha forte.
JARVIS_PASSWORD=
JARVIS_COOKIE_SECURE=false
JARVIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080
JARVIS_OPENAI_KEY=
JARVIS_OPENAI_MODEL=gpt-4.1-mini
# Brave Search API: https://api-dashboard.search.brave.com/
JARVIS_SEARCH_KEY=
# Token do bot criado via @BotFather. O destinatário precisa iniciar conversa com o bot.
JARVIS_TELEGRAM_TOKEN=
JARVIS_HISTORY_DAYS=30
